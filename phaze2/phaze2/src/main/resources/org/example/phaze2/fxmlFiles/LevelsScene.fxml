<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="MainPane"
            prefHeight="1019.0" prefWidth="1707.0"
            styleClass="root-pane"
            stylesheets="@../cssStyles/LevelsStyle.css"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.phaze2.controllers.sceneControllers.LevelController">

    <children>
        <Label alignment="CENTER"
               prefHeight="87.0" prefWidth="1707.0"
               styleClass="menu-title"
               text="Select a Level"
               AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0"
               AnchorPane.topAnchor="40.0">
            <font>
                <Font size="39.0"/>
            </font>
        </Label>

        <Button fx:id="BackButton"
                text="← Back"
                styleClass="back-button"
                mnemonicParsing="false"
                AnchorPane.leftAnchor="22.0"
                AnchorPane.topAnchor="28.0"/>


        <ScrollPane fitToWidth="true" fitToHeight="true"
                    hbarPolicy="NEVER"
                    styleClass="levels-scroll"
                    AnchorPane.topAnchor="140.0"
                    AnchorPane.bottomAnchor="24.0"
                    AnchorPane.leftAnchor="24.0"
                    AnchorPane.rightAnchor="24.0">
            <content>
                <TilePane fx:id="levelsPane"
                          styleClass="levels-grid"
                          hgap="12.0" vgap="12.0"
                          prefTileWidth="160.0"
                          prefTileHeight="60.0"/>
            </content>
        </ScrollPane>

    </children>
</AnchorPane>
